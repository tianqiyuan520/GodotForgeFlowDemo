z_index = 1
z_as_relative = false
material = SubResource("ShaderMaterial_atlas")
multimesh = SubResource("MultiMesh_items")
texture = ExtResource("2_atlas")

[node name="DiagSprite" type="Sprite2D" parent="." unique_id=212319044]
z_as_relative = false
visible = false
z_index = 2
position = Vector2(300, 200)
texture = ExtResource("2_atlas")

; ProbeMultiMesh 现在身兼两职：
;   ① 诊断（FORGEFLOW_DIAG_MULTIMESH=1 时写 1 个放大实例，用来隔离「MultiMesh 能不能画」）；
;   ② **蓝图粘贴预览**（把剪贴板内容按光标位置画一遍）。
; 两者不会同时用；所以它也需要图集材质，否则预览会画成一片纯色方块。
[node name="ProbeMultiMesh" type="MultiMeshInstance2D" parent="." unique_id=1943920488]
z_as_relative = false
visible = false
z_index = 3
material = SubResource("ShaderMaterial_preview")
multimesh = SubResource("MultiMesh_probe")
texture = ExtResource("2_atlas")

; 建造幽灵预览：直接复用图集（region 指向当前可建造项的取样框），代码只改 position/region/modulate/rotation。
; z_index 高于工厂内容，保证永远画在最上面。
[node name="BuildGhost" type="Sprite2D" parent="."]
z_as_relative = false
visible = false
z_index = 10
texture = ExtResource("2_atlas")

; 框选矩形（蓝图复制用）：只是一个视觉反馈，mouse_filter 同样是 IGNORE。
[node name="SelectionRect" type="ColorRect" parent="."]
z_as_relative = false
visible = false
z_index = 9
mouse_filter = 2
color = Color(0.45, 0.72, 1, 0.18)

; ============================================================================
; 预览矩形池 —— 「铺带会铺到哪」与「拆除会拆掉谁」的占地高亮。
;
; 为什么是矩形而不是逐格描边：
;   一段带永远是横或竖的**直线**（模拟侧 DrawBelt 只接受横/竖），机器占地也是矩形，
;   所以占地天然就是一个矩形；而节点必须**在场景里预建**（工程约定），
;   于是固定开 3 个复用：L 形拖拽最多 2 段 + 余量 1。
;   颜色由脚本按状态给：淡蓝 = 能铺、淡红 = 有冲突、橙红 = 拆除目标（见 WalkingSkeleton）。
; 代码里容器是 `PreviewRect00..NN` 顺序扫描，**加一个节点就多一块**，不需要改代码。
; ============================================================================
[node name="PreviewRect00" type="ColorRect" parent="."]
z_as_relative = false
visible = false
z_index = 8
mouse_filter = 2
color = Color(0.45, 0.72, 1, 0.3)

[node name="PreviewRect01" type="ColorRect" parent="."]
z_as_relative = false
visible = false
z_index = 8
mouse_filter = 2
color = Color(0.45, 0.72, 1, 0.3)

[node name="PreviewRect02" type="ColorRect" parent="."]
z_as_relative = false
visible = false
z_index = 8
mouse_filter = 2
color = Color(0.45, 0.72, 1, 0.3)

; ============================================================================
; HUD —— 全部节点在场景里预建（遵守工程约定），脚本只改 text / visible / modulate。
; CanvasLayer ⇒ 不受 Camera2D 影响，永远贴在屏幕上。
; ============================================================================
[node name="Hud" type="CanvasLayer" parent="."]

[node name="Panel" type="PanelContainer" parent="Hud"]
offset_left = 12.0
offset_top = 12.0
offset_right = 12.0
offset_bottom = 12.0
theme_override_styles/panel = SubResource("StyleBox_hud")
; ⚠ 必须**同时**给一个最小宽度：PanelContainer 的宽度取自子节点的**最小宽度**，
;   而开了 autowrap 之后每个 Label 的最小宽度塌成长单词（中文约 1 个字）⇒
;   只加 autowrap 会让整块面板缩成一条竖条、每行折成一两个字。
;   定死宽度 + autowrap 才是「面板不随文本变宽、长行自己折行」。
custom_minimum_size = Vector2(480, 0)
; ⚠ mouse_filter = 2（IGNORE）**必须设**：PanelContainer 默认是 STOP，
;   它盖住的那一片厂区，鼠标点击会被**全部吃掉**，玩家看到的是「点了没反应」。
;   面板里全是 Label，没有任何需要点的地方，所以直接让它忽略鼠标。
mouse_filter = 2

