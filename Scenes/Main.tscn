theme_override_font_sizes/font_size = 12
theme_override_colors/font_color = Color(0.62, 0.7, 0.8, 0.62)
autowrap_mode = 2
text = "左键：放置 / 铺带 / 单击选中 · 右键单击：拆一个 · 右键拖：框选 · X 或 Delete：拆选中"

; ============================================================================
; **轨道选择器**（左下角）—— 点机器之后在这里选它绑定哪条轨道（输入 / 输出）。
;
; 为什么要有它：带可以交错之后，「这台机器的输入是哪条带」几何已经推不出来
; （旁边可能挨着好几条带；带从机器旁边**中段擦过**时几何更是完全发现不了）——
; 见 FactoryLayout.MachineDef.InBeltBinding 的说明。
;
; 工程约定（AGENTS.md §2）：节点全部在这里预建，脚本只做解析、连线、改文本/可见性。
;   · 候选轨道用 **ItemList 的条目**（条目是引擎画的，不是节点）—— 加多少条轨道都不用新节点；
;   · 三个按钮**同一套选择器复用**：绑定输入 / 绑定输出 / 解除，作用对象都是列表里选中的那条。
;
; ⚠ 只在「选中一台机器」时可见（脚本控制）。不可见时它不吃鼠标 —— 这是有意的：
;   全屏或长期存在的 Control 会把那一带的点击全吃掉（AGENTS.md §5 那条 PanelContainer 坑）。
;
; ⚠ 摆在**右下角**（不是左下角）：左下角正是交错高低轨展示区（第 24..26 行，见
;   WalkingSkeleton.CreateSim）所在的地方 —— 面板一开就把"要看的东西"盖住了。
;   右边这一列只有顶部的建造菜单，底部是空的。
; ============================================================================
[node name="TrackPicker" type="PanelContainer" parent="Hud"]
visible = false
anchors_preset = 3
anchor_left = 1.0
anchor_top = 1.0
anchor_right = 1.0
anchor_bottom = 1.0
offset_left = -402.0
offset_top = -276.0
offset_right = -12.0
offset_bottom = -12.0
grow_horizontal = 0
grow_vertical = 0
theme_override_styles/panel = SubResource("StyleBox_hud")

